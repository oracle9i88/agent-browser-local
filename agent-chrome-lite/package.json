{
  "name": "agent-browser-local",
  "version": "0.3.0-beta.6",
  "description": "Contribution-only local Chromium browser for Codex, Claude, NovaGe and NovaDe",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/oracle9i88/agent-browser-local.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "src/main.mjs",
  "bin": {
    "agent-browser-local": "./bin/acl.mjs"
  },
  "scripts": {
    "start": "electron .",
    "start:dev": "ACL_DEVTOOLS=1 electron .",
    "package:mac": "node ./scripts/package-macos.mjs",
    "test:packaged": "node ./scripts/packaged-smoke.mjs",
    "doctor": "node ./scripts/doctor.mjs",
    "mcp": "node ./mcp/server.mjs",
    "init-config": "node ./scripts/init-config.mjs",
    "platforms": "node ./scripts/register-platforms.mjs",
    "store-tokens": "node ./scripts/store-tokens.mjs",
    "test": "node --test",
    "test:upload": "electron ./test/electron-gold-app",
    "test:chromium-gold": "electron ./test/electron-gold-app",
    "test:mcp": "node ./scripts/mcp-smoke.mjs",
    "test:ws": "node ./scripts/ws-smoke.mjs",
    "test:protocols": "ABL_PROTOCOL_TEST=1 node --test ./test/protocol-adapters.test.mjs",
    "test:python": "python3 -m unittest discover -s ./adapters/python -p 'test_*.py'",
    "check": "node ./scripts/check-syntax.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "electron": "^43.3.0",
    "ws": "^8.21.2",
    "zod": "^4.4.3"
  }
}
